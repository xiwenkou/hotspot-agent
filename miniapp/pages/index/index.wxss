.header {
  margin-bottom: 28rpx;
  padding-top: 20rpx;
}

.eyebrow {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-color);
  margin-bottom: 8rpx;
  text-transform: uppercase;
}

.greeting {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.updated {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

.tabs {
  display: flex;
  background-color: var(--bg-card);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.tab-item.active {
  background-color: var(--accent-color);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.state-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.state-card.error {
  border-color: rgba(239, 68, 68, 0.18);
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.state-copy {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.retry-button {
  margin: 28rpx 0 0;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background-color: var(--accent-color);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.retry-button::after {
  border: none;
}
